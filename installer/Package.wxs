<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="API 签到助手"
           Manufacturer="ApiCheckinHelper"
           Version="$(var.ProductVersion)"
           UpgradeCode="{CC94FF7E-2FCA-45DD-A504-9E5A55A73B2D}"
           Scope="perMachine"
           Codepage="936"
           Language="2052">
    <MajorUpgrade DowngradeErrorMessage="A newer version of API 签到助手 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(var.AppSource)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPDESCRIPTION" Value="API 签到助手" />
    <Feature Id="MainFeature" Title="API 签到助手" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ApiCheckinHelper" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppSource)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{9A0FFFF6-6085-46C3-9C8F-51C79A7C6E1B}">
        <Shortcut Id="StartMenuShortcutLink"
                  Name="API 签到助手"
                  Target="[INSTALLFOLDER]ApiCheckinHelper.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  IconIndex="0" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\ApiCheckinHelper\Shortcuts"
                       Name="StartMenu"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
